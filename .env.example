# Local-First Multimodal PDF Intelligence System - environment template
#
# Copy to .env and fill only the values you need. Never commit .env or real keys.
# Local mode works with every value below left blank; cloud mode requires a key
# and explicit in-app consent.

# --- Optional cloud providers (blank by default; local mode does not use them) ---
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Local llama-server connection ---
# Prefer LLAMA_SERVER_URL, or set HOST + PORT instead (URL wins when both exist).
LLAMA_SERVER_URL=
LLAMA_SERVER_HOST=127.0.0.1
LLAMA_SERVER_PORT=8080

# --- Docling model artifacts (optional; blank uses the package default) ---
DOCLING_ARTIFACTS_PATH=

# --- Logging ---
RAG_LOG_LEVEL=INFO
RAG_LOG_DIR=data/logs

# --- Security and integrity toggles ---
# Verify downloaded model/binary checksums where supported (recommended).
RAG_REQUIRE_CHECKSUMS=1

# Allow Streamlit to bind a non-loopback address. The app has NO authentication;
# leave at 0 unless you deliberately trust every host on the network.
RAG_ALLOW_NON_LOOPBACK=0
